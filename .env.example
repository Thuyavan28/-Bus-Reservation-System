# ================= backend (copy to backend/.env) =================
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:4000

# MongoDB Atlas. Replace <cluster-host> (e.g. cluster0.abcde.mongodb.net).
# While <cluster-host> is left in place (or USE_MEMORY_DB=true) the server runs on an
# in-memory replica set and auto-seeds demo data. Data is lost on restart.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/busgo?retryWrites=true&w=majority
USE_MEMORY_DB=
# Set SEED=true once to load demo data into a real database.
SEED=

JWT_ACCESS_SECRET=change-me-please
JWT_REFRESH_SECRET=change-me-too-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Road routing. OSRM = real roads from OpenStreetMap (public demo server; self-host for production). Empty disables it.
OSRM_URL=https://router.project-osrm.org
# Google (server key: Routes API, never sent to the client). Optional; used first when set.
GOOGLE_MAPS_SERVER_KEY=

# Email: smtp or resend. With neither configured, emails are rendered and logged (status "logged").
EMAIL_PROVIDER=smtp
# Gmail: SMTP_PASS must be an App Password (Google Account > Security > 2-Step Verification > App passwords), not the login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thuyavan175@gmail.com
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM="BusGo South <thuyavan175@gmail.com>"

# Payments: QR scan -> accept/reject page (no Razorpay). The QR encodes PUBLIC_APP_URL/pay/approve/<token>.
# Use an address your phone can reach (LAN IP) to scan with a real phone. Empty => CLIENT_URL.
PUBLIC_APP_URL=
# Optional alternative: redirect to an EXTERNAL payment website.
# Empty EXTERNAL_PAYMENT_URL => the built-in /mock-gateway demo site is used.
EXTERNAL_PAYMENT_URL=
# Optional: where refunds are requested (POST, HMAC signed). Empty => refunds wait for webhook/operator.
EXTERNAL_REFUND_URL=
# Shared secret: the payment site signs webhook bodies with HMAC-SHA256 (header x-signature).
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# AI assistant (Groq). Key 2 is used automatically if key 1 fails.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# ================= frontend (copy to frontend/.env) =================
# VITE_ vars are public.
VITE_API_URL=/api
# Optional: custom map tiles (default: Esri World Imagery satellite)
VITE_MAP_TILES=
VITE_MAP_ATTRIBUTION=
